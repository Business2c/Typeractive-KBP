#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL  10    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <1>;
};

&msc {
    x-input-code = <INPUT_REL_HWHEEL>;
    y-input-code = <INPUT_REL_WHEEL>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
&kp TAB           &kp V  &kp W  &kp F                  &kp P        &lt 6 DELETE    &lt 6 INSERT   &kp J        &kp U                      &kp L  &kp Y  &kp RS(CAPSLOCK)
&kp LEFT_CONTROL  &kp A  &kp R  &kp S                  &kp T        &kp G           &kp M          &kp N        &kp E                      &kp I  &kp O  &kp RIGHT_CONTROL
&kp LEFT_GUI      &kp Z  &kp X  &kp C                  &kp D        &kp LEFT_ALT    &kp RIGHT_ALT  &kp H        &kp B                      &kp K  &kp Q  &kp RIGHT_GUI
                                &mt LEFT_SHIFT ESCAPE  &lt 2 SPACE  &lt 4 ENTER     &lt 5 ENTER    &lt 3 SPACE  &mt RIGHT_SHIFT BACKSPACE
            >;
        };

        Bravo {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E                  &kp R        &lt 6 T        &lt 6 Y      &kp U        &kp I                      &kp O     &kp P          &kp RS(CAPSLOCK)
&kp LEFT_CONTROL  &kp A  &kp S  &kp D                  &kp F        &kp G          &kp H        &kp J        &kp K                      &kp L     &kp DELETE     &kp RIGHT_CONTROL
&kp LEFT_GUI      &kp Z  &kp X  &kp C                  &kp V        &kp B          &kp N        &kp M        &kp COLON                  &kp SEMI  &kp RIGHT_ALT  &kp RIGHT_GUI
                                &mt LEFT_SHIFT ESCAPE  &lt 2 SPACE  &lt 4 ENTER    &lt 5 ENTER  &lt 3 SPACE  &mt RIGHT_SHIFT BACKSPACE
            >;
        };

        NumPunc {
            bindings = <
&kp PLUS   &kp SEMICOLON  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans              &trans             &trans     &trans         &trans  &trans  &trans
&kp MINUS  &kp NUMBER_0   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD          &kp COLON          &trans     &trans         &trans  &trans  &trans
&kp EQUAL  &kp COMMA      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SINGLE_QUOTE    &kp DOUBLE_QUOTES  &trans     &trans         &trans  &trans  &trans
                                        &trans        &trans        &trans              &kp ENTER          &kp SPACE  &kp BACKSPACE
            >;
        };

        Symbols {
            bindings = <
&trans  &trans  &kp AMPERSAND    &kp ASTERISK  &kp UNDERSCORE  &trans          &trans  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp SLASH             &kp BACKSLASH          &trans
&trans  &trans  &kp DOLLAR       &kp PERCENT   &kp CARET       &kp GRAVE       &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH        &kp QUESTION    &trans  &kp LESS_THAN     &kp GREATER_THAN   &kp PIPE              &kp TILDE              &trans
                                 &kp ESCAPE    &kp SPACE       &kp ENTER       &trans  &trans            &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &trans  &kp LC(PLUS)    &msc SCRL_UP    &kp LC(MINUS)    &trans    &trans  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &trans  &kp LEFT     &kp DOWN      &kp RIGHT      &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans    &trans  &kp HOME     &trans        &kp END        &trans  &trans
                                &trans          &trans           &trans    &mo 7   &trans       &trans
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans    &trans  &mkp MB5        &mmv MOVE_UP    &mkp MB4         &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans    &trans  &trans          &trans          &trans           &trans  &trans
                           &trans     &trans     &mo 7     &trans  &trans          &trans
            >;
        };

        Function {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &trans  &to 0   &trans  &trans  &kp C_VOLUME_UP
&bt BT_SEL 2  &bt BT_SEL 3  &kp F4  &kp F5  &kp F6  &kp F11    &trans  &trans  &to 1   &trans  &trans  &kp C_VOL_DN
&bt BT_SEL 4  &bt BT_CLR    &kp F1  &kp F2  &kp F3  &kp F12    &trans  &trans  &trans  &trans  &trans  &kp K_MUTE
                                    &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };

        Power {
            bindings = <
&trans  &trans     &kp LC(LG(LEFT_ARROW))  &kp LC(T)    &kp LC(LG(RIGHT_ARROW))  &trans           &trans  &kp RG(LEFT)         &kp RG(UP_ARROW)  &kp RG(RIGHT)    &trans     &trans
&trans  &kp LG(D)  &kp LC(LS(TAB))         &kp LC(W)    &kp LC(TAB)              &kp LS(LC(T))    &trans  &kp RA(RS(ESCAPE))   &kp RG(DOWN)      &kp RA(ESCAPE)   &kp RC(N)  &trans
&trans  &trans     &kp LC(LG(F4))          &kp LG(TAB)  &kp LC(LG(D))            &trans           &trans  &kt RS(RA(RC(TAB)))  &kp RA(F4)        &kp RA(RC(TAB))  &trans     &trans
                                           &trans       &trans                   &trans           &trans  &trans               &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
