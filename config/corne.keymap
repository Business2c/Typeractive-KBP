#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL  10    // default: 10
#define SLOW_LAYER 6
#define FAST_LAYER 2

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    x-input-code = <INPUT_REL_X>;
    y-input-code = <INPUT_REL_Y>;
    time-to-max-speed-ms = <1>;      // changed from 0 — see note below
    acceleration-exponent = <0>;
};

&msc {
    x-input-code = <INPUT_REL_HWHEEL>;
    y-input-code = <INPUT_REL_WHEEL>;
    time-to-max-speed-ms = <1>;      // changed from 0 — see note below
    acceleration-exponent = <0>;
};

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 1 1>;

    slow_layer {
        layers = <SLOW_LAYER>;
        input-processors = <&zip_xy_scaler 1 4>;   // 0.25x speed
    };

    fast_layer {
        layers = <FAST_LAYER>;
        input-processors = <&zip_xy_scaler 3 2>;   // 1.5x speed
    };
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Bravo {
            bindings = <
&trans  &kp Q  &kp W  &kp E                  &kp R        &lt 7 T               &lt 7 Y              &kp U        &kp I                      &kp O          &kp P          &trans
&trans  &kp A  &kp S  &kp D                  &kp F        &mt LEFT_CONTROL G    &mt RIGHT_CONTROL H  &kp J        &kp K                      &kp L          &kp DELETE     &trans
&trans  &kp Z  &kp X  &kp C                  &kp V        &kp B                 &kp N                &kp M        &kp TAB                    &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
                      &mt LEFT_SHIFT ESCAPE  &lt 2 SPACE  &lt 4 ENTER           &lt 5 ENTER          &lt 3 SPACE  &mt RIGHT_SHIFT BACKSPACE
            >;
        };

        Alpha {
            bindings = <
&trans  &kp V  &kp W  &kp F                  &kp P        &lt 7 DELETE          &lt 7 TAB            &kp J        &kp U                      &kp L  &kp Y  &trans
&trans  &kp A  &kp R  &kp S                  &kp T        &mt LEFT_CONTROL G    &mt RIGHT_CONTROL M  &kp N        &kp E                      &kp I  &kp O  &trans
&trans  &kp Z  &kp X  &kp C                  &kp D        &kp LEFT_GUI          &kp RIGHT_ALT        &kp H        &kp B                      &kp K  &kp Q  &trans
                      &mt LEFT_SHIFT ESCAPE  &lt 2 SPACE  &lt 4 ENTER           &lt 5 ENTER          &lt 3 SPACE  &mt RIGHT_SHIFT BACKSPACE
            >;
        };

        NumPunc {
            bindings = <
&trans  &kp SEMICOLON  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSPACE       &trans             &kp PLUS   &trans         &trans  &trans  &trans
&trans  &kp NUMBER_0   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD          &kp COLON          &kp MINUS  &trans         &trans  &trans  &trans
&trans  &kp COMMA      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SINGLE_QUOTE    &kp DOUBLE_QUOTES  &kp EQUAL  &trans         &trans  &trans  &trans
                                     &kp CAPS      &trans        &trans              &kp ENTER          &kp SPACE  &kp BACKSPACE
            >;
        };

        Symbols {
            bindings = <
&trans  &trans  &kp AMPERSAND    &kp ASTERISK  &kp UNDERSCORE  &kp DELETE      &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH       &kp BACKSLASH    &trans
&trans  &trans  &kp DOLLAR       &kp PERCENT   &kp CARET       &kp GRAVE       &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
&trans  &trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH        &kp QUESTION    &trans  &kp LESS_THAN         &kp GREATER_THAN       &kp PIPE        &kp TILDE        &trans
                                 &kp ESCAPE    &kp SPACE       &kp ENTER       &trans  &trans                &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &trans  &kp LC(PLUS)    &msc SCRL_UP    &kp LC(MINUS)    &trans    &trans  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &trans  &kp LEFT     &kp DOWN      &kp RIGHT      &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans    &trans  &kp HOME     &trans        &kp END        &trans  &trans
                                &trans          &trans           &trans    &mo 8   &trans       &trans
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans    &trans  &mkp MB5        &mmv MOVE_UP    &mkp MB4         &trans  &trans
&trans  &mo 6   &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans    &trans  &trans          &trans          &trans           &trans  &trans
                           &trans     &trans     &mo 8     &trans  &trans          &trans
            >;
        };

        MouseSlow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        Function {
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp C_VOLUME_UP    &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11    &to 0   &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &kp C_VOLUME_DOWN  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12    &to 1   &trans        &trans        &trans        &kp C_MUTE         &trans
                        &trans  &trans  &trans     &trans  &trans        &trans
            >;
        };

        Power {
            bindings = <
&trans  &trans     &kp LC(LG(LEFT_ARROW))  &kp LC(T)    &kp LC(LG(RIGHT_ARROW))  &trans           &trans  &kp RG(LEFT)         &kp RG(UP_ARROW)  &kp RG(RIGHT)    &trans     &trans
&trans  &kp LG(D)  &kp LC(LS(TAB))         &kp LC(W)    &kp LC(TAB)              &kp LS(LC(T))    &trans  &kp RA(RS(ESCAPE))   &kp RG(DOWN)      &kp RA(ESCAPE)   &kp RC(N)  &trans
&trans  &trans     &kp LC(LG(F4))          &kp LG(TAB)  &kp LC(LG(D))            &trans           &trans  &kt RS(RA(RC(TAB)))  &kp RA(F4)        &kp RA(RC(TAB))  &trans     &trans
                                           &trans       &trans                   &trans           &trans  &trans               &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
